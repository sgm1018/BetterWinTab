<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="BetterWinTab.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterWinTab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- BetterWinTab — Neon Tactical Dark Theme                -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- Core Colors -->
            <Color x:Key="NeonGreen">#39FF14</Color>
            <Color x:Key="NeonGreenDim">#1A8A0A</Color>
            <Color x:Key="NeonGreenSubtle">#0D3D06</Color>
            <Color x:Key="PureBlack">#000000</Color>
            <Color x:Key="DarkSurface">#0A0A0A</Color>
            <Color x:Key="CardSurface">#111111</Color>
            <Color x:Key="BorderDark">#1A1A1A</Color>
            <Color x:Key="BorderNeon">#39FF14</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#AAAAAA</Color>
            <Color x:Key="TextMuted">#666666</Color>
            <Color x:Key="DangerRed">#FF3344</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreen}" />
            <SolidColorBrush x:Key="NeonGreenDimBrush" Color="{StaticResource NeonGreenDim}" />
            <SolidColorBrush x:Key="NeonGreenSubtleBrush" Color="{StaticResource NeonGreenSubtle}" />
            <SolidColorBrush x:Key="PureBlackBrush" Color="{StaticResource PureBlack}" />
            <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurface}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurface}" />
            <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}" />
            <SolidColorBrush x:Key="BorderNeonBrush" Color="{StaticResource BorderNeon}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
            <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
            <Color x:Key="FolderHover">#1A39FF14</Color>
            <Color x:Key="FolderSelected">#2939FF14</Color>
            <SolidColorBrush x:Key="FolderHoverBrush" Color="{StaticResource FolderHover}" />
            <SolidColorBrush x:Key="FolderSelectedBrush" Color="{StaticResource FolderSelected}" />
            <Color x:Key="WindowHoverBorder">#6639FF14</Color>
            <Color x:Key="WindowHoverBackground">#0C39FF14</Color>
            <SolidColorBrush x:Key="WindowHoverBorderBrush" Color="{StaticResource WindowHoverBorder}" />
            <SolidColorBrush x:Key="WindowHoverBackgroundBrush" Color="{StaticResource WindowHoverBackground}" />

            <!-- Font sizes -->
            <x:Double x:Key="FontSizeXSmall">9</x:Double>
            <x:Double x:Key="FontSizeSmall">11</x:Double>
            <x:Double x:Key="FontSizeBase">13</x:Double>
            <x:Double x:Key="FontSizeMedium">14</x:Double>
            <x:Double x:Key="FontSizeLarge">18</x:Double>
            <x:Double x:Key="FontSizeXLarge">24</x:Double>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Folder Sidebar Button                                  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Style x:Key="FolderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,3,0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Window Card                                            -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Style x:Key="WindowCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Neon Action Button                                     -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Style x:Key="NeonButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Danger Button (Delete)                                 -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Input TextBox                                          -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Style x:Key="NeonTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource DarkSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NeonGreenDimBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
