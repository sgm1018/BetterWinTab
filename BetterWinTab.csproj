<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>

        <!-- WinUI 3 -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">true</WindowsAppSDKSelfContained>
        <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>BetterWinTab</RootNamespace>

        <!-- Suppress platform compatibility warnings (Windows-only app) -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x86;x64;ARM64</Platforms>
        <!-- Default platform for VS Code IntelliSense (dotnet build requires -p:Platform=x64 explicitly) -->
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\logos\betterWinTab.ico</ApplicationIcon>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
        <OnnxRuntimeVersion>1.30.0</OnnxRuntimeVersion>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
        <!-- Notes editor (HTML/CSS/JS hosted in WebView2) -->
        <Content Include="Assets\NotesEditor\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="BetterWinTab.slnx" />
        <Compile Remove="BrowserExtension\**\*.cs" />
        <EmbeddedResource Remove="BrowserExtension\**\*" />
        <None Remove="BrowserExtension\**\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
        <PackageReference Include="System.Text.Json" Version="9.*" />

        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <!-- Windows App SDK also stages an older ONNX DLL for Windows ML.
         Our direct Microsoft.ML.OnnxRuntime reference needs its matching native runtime. -->
    <PropertyGroup Condition="'$(Platform)' == 'x64'">
        <OnnxRuntimeNativeRid>win-x64</OnnxRuntimeNativeRid>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
        <OnnxRuntimeNativeRid>win-arm64</OnnxRuntimeNativeRid>
    </PropertyGroup>
    <Target Name="CopyMatchingOnnxRuntimeNativeLibraries"
            AfterTargets="Build;Publish"
            Condition="'$(OnnxRuntimeNativeRid)' != ''">
        <ItemGroup>
            <_OnnxRuntimeNative Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\$(OnnxRuntimeVersion)\runtimes\$(OnnxRuntimeNativeRid)\native\onnxruntime.dll" />
            <_OnnxRuntimeNative Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\$(OnnxRuntimeVersion)\runtimes\$(OnnxRuntimeNativeRid)\native\onnxruntime_providers_shared.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_OnnxRuntimeNative)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(_OnnxRuntimeNative)"
              DestinationFolder="$(PublishDir)"
              Condition="'$(PublishDir)' != ''"
              SkipUnchangedFiles="false" />
    </Target>
</Project>
