<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterWinTab.Controls.MarkdownPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid Background="{ThemeResource PureBlackBrush}">
        <ScrollViewer x:Name="Fallback" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,4,8,32" MaxWidth="900" HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock x:Name="FallbackNotice" Visibility="Collapsed"
                           Text="Notes preview unavailable. Showing plain text."
                           Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="FallbackText" Text="{x:Bind Markdown, Mode=OneWay}"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           FontFamily="Segoe UI" FontSize="16" LineHeight="26.4"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <WebView2 x:Name="Viewer" Opacity="0" IsHitTestVisible="False"
                  DefaultBackgroundColor="Black" AllowDrop="False"
                  AutomationProperties.Name="Generated call notes" />
    </Grid>
</UserControl>
