                                <!-- Text Secondary -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Text Secondary" Text="{x:Bind ViewModel.Settings.SettingsTextSecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsTextSecondaryColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_TextSecondary" Tag="TextSecondary" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Text Muted -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Text Muted" Text="{x:Bind ViewModel.Settings.SettingsTextMutedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsTextMutedColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_TextMuted" Tag="TextMuted" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ══════════════════════════════════════════════════ -->
                        <!-- STATUS PANEL                                       -->
                        <!-- ══════════════════════════════════════════════════ -->
                        <ScrollViewer x:Name="StatusPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.Settings.TabStatusVisible, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Status"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Danger and other status indicator colors."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Reset Section"
                                                Command="{x:Bind ViewModel.Settings.ResetStatusSectionCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                        <Button Content="Reset All"
                                                Command="{x:Bind ViewModel.Settings.ResetAppearanceDefaultsCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Danger -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Danger (delete buttons)" Text="{x:Bind ViewModel.Settings.SettingsDangerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsDangerColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Danger" Tag="Danger" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>

                    <!-- ── Footer (fixed) ── -->
                    <Border Grid.Row="2" Padding="24,12" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Social Links (left) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Button ToolTipService.ToolTip="LinkedIn" Click="LinkedIn_Click"
                                        Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                                    <Viewbox Width="20" Height="20">
                                        <Path Fill="White" Stretch="Uniform" Data="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zM20 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765C14.396 7.179 20 6.988 20 12.241V19z" />
                                    </Viewbox>
                                </Button>
                                <Button ToolTipService.ToolTip="GitHub" Click="GitHub_Click"
                                        Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                                    <Viewbox Width="20" Height="20">
                                        <Path Fill="White" Stretch="Uniform" Data="M12 0c-6.627 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.106-.774.418-1.305.761-1.604-2.666-.304-5.467-1.333-5.467-5.93 0-1.312.469-2.382 1.236-3.222-.124-.303-.535-1.524.117-3.176 0 0 1.009-.322 3.301 1.23A11.513 11.513 0 0112 5.802c1.02.004 2.047.138 3.006.404 2.291-1.552 3.3-1.23 3.3-1.23.653 1.653.242 2.874.118 3.176.768.84 1.236 1.91 1.236 3.222 0 4.609-2.804 5.625-5.475 5.921.43.371.813 1.102.813 2.222v3.293c0 .319.192.694.801.576C20.565 21.796 24 17.299 24 12c0-6.627-5.373-12-12-12z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                            <!-- Action Buttons (right) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button
                                    Content="Cancel"
                                    Command="{x:Bind ViewModel.Settings.CancelSettingsCommand}"
                                    Style="{StaticResource DangerButtonStyle}" />
                                <Button
                                    Content="Save"
                                    Command="{x:Bind ViewModel.Settings.SaveSettings_UICommand}"
                                    Style="{StaticResource NeonButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ONBOARDING OVERLAY (first-run walkthrough)                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#CC000000"
              Visibility="{x:Bind ViewModel.Onboarding.IsOnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#0F0F0F" CornerRadius="12"
                    BorderBrush="{StaticResource NeonGreenSubtleBrush}" BorderThickness="1"
                    Padding="32,28">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.Onboarding.OnboardingProgressText, Mode=OneWay}"
                               HorizontalAlignment="Right" FontSize="12"
                               Foreground="{StaticResource NeonGreenDimBrush}" />
                    <FontIcon Glyph="{x:Bind ViewModel.Onboarding.OnboardingStepIcon, Mode=OneWay}"
                              FontSize="48" HorizontalAlignment="Center"
                              Foreground="{StaticResource NeonGreenBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Onboarding.OnboardingStepTitle, Mode=OneWay}"
                               FontSize="22" FontWeight="Bold" TextAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Onboarding.OnboardingStepDescription, Mode=OneWay}"
                               FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Border Height="1" Background="#1AFFFFFF" Margin="0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Skip"
                                Command="{x:Bind ViewModel.Onboarding.SkipOnboardingCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Left" Padding="0,8" />
                        <Button Grid.Column="1"
                                Content="{x:Bind ViewModel.Onboarding.OnboardingNextButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Onboarding.NextOnboardingStepCommand}"
                                Background="{StaticResource NeonGreenSubtleBrush}"
                                BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                CornerRadius="6" Padding="20,8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>

