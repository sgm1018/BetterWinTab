                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsBackgroundColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Background" Tag="Background" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Surface -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Surface (sidebar)" Text="{x:Bind ViewModel.Settings.SettingsSurfaceColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsSurfaceColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Surface" Tag="Surface" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Card -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Card (window cards)" Text="{x:Bind ViewModel.Settings.SettingsCardColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsCardColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Card" Tag="Card" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Border -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Border" Text="{x:Bind ViewModel.Settings.SettingsBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsBorderColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Border" Tag="Border" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Folder Hover -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Folder Hover overlay" Text="{x:Bind ViewModel.Settings.SettingsFolderHoverColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsFolderHoverColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_FolderHover" Tag="FolderHover" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Folder Selected -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Folder Selected overlay" Text="{x:Bind ViewModel.Settings.SettingsFolderSelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsFolderSelectedColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_FolderSelected" Tag="FolderSelected" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Window Hover Border -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Window Hover Border" Text="{x:Bind ViewModel.Settings.SettingsWindowHoverBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsWindowHoverBorderColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_WindowHoverBorder" Tag="WindowHoverBorder" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Window Hover Background -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Window Hover Background" Text="{x:Bind ViewModel.Settings.SettingsWindowHoverBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.Settings.SettingsWindowHoverBackgroundColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_WindowHoverBackground" Tag="WindowHoverBackground" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ══════════════════════════════════════════════════ -->
                        <!-- TYPOGRAPHY PANEL                                   -->
                        <!-- ══════════════════════════════════════════════════ -->
