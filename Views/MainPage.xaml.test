<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BetterWinTab.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BetterWinTab.ViewModels"
    xmlns:conv="using:BetterWinTab.Converters"
    xmlns:models="using:BetterWinTab.Models"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    IsTabStop="True"
    AllowFocusOnInteraction="True"
    Background="{StaticResource PureBlackBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Up" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Down" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
        <conv:HexColorToColorConverter x:Key="HexToColor" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Global search bar (full width) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Sidebar + window grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Folder navigation -->
            <ColumnDefinition Width="280" />
            <!-- Main area: Window previews -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- GLOBAL SEARCH BAR (full-width top strip)                       -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#050505"
            BorderBrush="{StaticResource NeonGreenSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0"
            Height="48">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search icon -->
                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE721;"
                    FontSize="15"
                    Foreground="{StaticResource NeonGreenDimBrush}"
                    VerticalAlignment="Center" />

                <!-- Search input -->
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    PlaceholderText="Search windows or launch apps..."
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    PlaceholderForeground="{StaticResource TextMutedBrush}"
                    FontSize="{StaticResource FontSizeMedium}"
                    VerticalAlignment="Center"
                    IsTabStop="True" />

                <!-- Result count badge -->
                <Border
                    Grid.Column="2"
                    Visibility="{x:Bind ViewModel.SearchClearVisibility, Mode=OneWay}"
                    Background="#1A39FF14"
                    BorderBrush="{StaticResource NeonGreenSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.SearchResultCount, Mode=OneWay}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource NeonGreenBrush}" />
                </Border>

                <!-- Clear button -->
                <Button
                    Grid.Column="3"
                    Visibility="{x:Bind ViewModel.SearchClearVisibility, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    VerticalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE711;"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- LEFT SIDEBAR â€” Folder List                                     -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource DarkSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Padding="20,24,20,16">
                <TextBlock
                    Text="BetterWinTab"
                    FontSize="{StaticResource FontSizeXLarge}"
                    FontWeight="Bold"
                    Foreground="{StaticResource NeonGreenBrush}" />
                <TextBlock
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource TextMutedBrush}"
                    Margin="0,4,0,0">
                    <Run Text="{x:Bind ViewModel.HotkeyDisplayText, Mode=OneWay}" />
                    <Run Text=" to toggle" />
                </TextBlock>
                <Border
                    Height="1"
                    Background="{StaticResource NeonGreenSubtleBrush}"
                    Margin="0,16,0,0" />
            </StackPanel>

            <!-- Folder List -->
            <ListView
                x:Name="FolderList"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.NonClipboardFolders}"
                SelectedItem="{x:Bind ViewModel.SelectedNonClipboardFolder, Mode=TwoWay}"
                SelectionMode="Single"
                CanReorderItems="True"
                AllowDrop="True"
                CanDragItems="True"
                DragItemsStarting="FolderList_DragItemsStarting"
                DragItemsCompleted="FolderList_DragItemsCompleted"
                Background="Transparent"
                IsTabStop="False"
                TabNavigation="Once"
                AllowFocusOnInteraction="False"
                XYFocusKeyboardNavigation="Disabled"
                Padding="8,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderItemViewModel">
                        <Grid Padding="12,10" ColumnSpacing="12"
                              Background="{x:Bind BackgroundBrush}" CornerRadius="6"
                              AllowDrop="True"
                              DragOver="FolderItem_DragOver"
                              Drop="FolderItem_Drop">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit Folder" Icon="Edit"
                                        Click="EditFolder_Click" Tag="{x:Bind}" />
                                    <MenuFlyoutItem Text="Delete Folder" Icon="Delete"
                                        Click="DeleteFolder_Click" Tag="{x:Bind}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Folder Icon -->
                            <FontIcon
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                Glyph="{x:Bind Icon}"
                                FontSize="22"
                                Foreground="{StaticResource NeonGreenBrush}"
                                VerticalAlignment="Center" />

                            <!-- Folder Name -->
                            <TextBlock
                                Grid.Column="1"
                                Grid.Row="0"
                                Text="{x:Bind Name}"
                                FontSize="{StaticResource FontSizeMedium}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />

                            <!-- Folder Filter Info -->
                            <TextBlock
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="{x:Bind FilterInfo}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="AllowFocusOnInteraction" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid x:Name="Root" CornerRadius="8">
                                        <VisualStateManager.VisualStateGroups>
                                            <!-- Single group: avoids two groups fighting over the same HoverBorder -->
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="Transparent" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderHoverBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenDimBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderSelectedBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderSelectedBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedUnfocused">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderSelectedBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenSubtleBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderSelectedBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverBorder.Background" Value="{StaticResource FolderSelectedBrush}" />
                                                        <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Padding="{TemplateBinding Padding}" />

                                        <!-- Hover/Selected overlay â€” rendered above content, not interactive -->
                                        <Border
                                            x:Name="HoverBorder"
                                            CornerRadius="8"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Padding="16" Spacing="8">
                <Border Height="1" Background="{StaticResource NeonGreenSubtleBrush}" Margin="0,0,0,8" />

                <!-- Recycle Bin Folder (pinned special folder â€” opens Windows Recycle Bin) -->
                <Grid CornerRadius="8" Margin="0,0,0,4"
                      Visibility="{x:Bind ViewModel.RecycleBinFolderVisibility, Mode=OneWay}">
                    <!-- Selection highlight -->
                    <Border CornerRadius="8" BorderThickness="2"
                            Background="{StaticResource FolderSelectedBrush}"
                            BorderBrush="{StaticResource NeonGreenBrush}"
                            Visibility="{x:Bind ViewModel.RecycleBinFolderIsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsHitTestVisible="False" />
                    <Button HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SelectRecycleBinFolderCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch">
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Grid.Column="0" Grid.RowSpan="2" Glyph="&#xE107;" FontSize="22"
                                      Foreground="{StaticResource NeonGreenBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="Recycle Bin"
                                       FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="Opens Windows Recycle Bin"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Clipboard Folder (pinned above action buttons) -->
                <Grid CornerRadius="8" Margin="0,0,0,4"
                      Visibility="{x:Bind ViewModel.ClipboardFolderVisibility, Mode=OneWay}">
                    <!-- Selection highlight -->
                    <Border CornerRadius="8" BorderThickness="2"
                            Background="{StaticResource FolderSelectedBrush}"
                            BorderBrush="{StaticResource NeonGreenBrush}"
                            Visibility="{x:Bind ViewModel.ClipboardFolderIsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsHitTestVisible="False" />
                    <Button HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SelectClipboardFolderCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch">
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Grid.Column="0" Grid.RowSpan="2" Glyph="&#xE8C8;" FontSize="22"
                                      Foreground="{StaticResource NeonGreenBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="Clipboard"
                                       FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="Clipboard history"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Button>
                </Grid>

                <Button
                    Content="+ Add Folder"
                    Command="{x:Bind ViewModel.ShowAddFolderPanelCommand}"
                    Style="{StaticResource NeonButtonStyle}"
                    HorizontalAlignment="Stretch" />

                <Button
                    Content="Delete Folder"
                    Command="{x:Bind ViewModel.DeleteSelectedFolderCommand}"
                    IsEnabled="{x:Bind ViewModel.CanDeleteSelectedFolder, Mode=OneWay}"
                    Style="{StaticResource DangerButtonStyle}"
                    HorizontalAlignment="Stretch" />

                <Button
                    Content="&#xE713; Settings"
                    Command="{x:Bind ViewModel.ShowSettingsPanelCommand}"
                    Style="{StaticResource NeonButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Opacity="0.7" />

                <!-- Social Links -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,4,0,0">
                    <Button ToolTipService.ToolTip="LinkedIn" Click="LinkedIn_Click"
                            Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                        <Viewbox Width="20" Height="20">
                            <Path Fill="White" Stretch="Uniform" Data="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zM20 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765C14.396 7.179 20 6.988 20 12.241V19z" />
                        </Viewbox>
                    </Button>
                    <Button ToolTipService.ToolTip="GitHub" Click="GitHub_Click"
                            Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                        <Viewbox Width="20" Height="20">
                            <Path Fill="White" Stretch="Uniform" Data="M12 0c-6.627 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.106-.774.418-1.305.761-1.604-2.666-.304-5.467-1.333-5.467-5.93 0-1.312.469-2.382 1.236-3.222-.124-.303-.535-1.524.117-3.176 0 0 1.009-.322 3.301 1.23A11.513 11.513 0 0112 5.802c1.02.004 2.047.138 3.006.404 2.291-1.552 3.3-1.23 3.3-1.23.653 1.653.242 2.874.118 3.176.768.84 1.236 1.91 1.236 3.222 0 4.609-2.804 5.625-5.475 5.921.43.371.813 1.102.813 2.222v3.293c0 .319.192.694.801.576C20.565 21.796 24 17.299 24 12c0-6.627-5.373-12-12-12z" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Sidebar/Content Separator -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Width="2"
            HorizontalAlignment="Right"
            Background="{StaticResource NeonGreenSubtleBrush}" />

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- RIGHT PANEL â€” Window Grid                                      -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource PureBlackBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Bar (hidden when Clipboard panel is shown â€” it has its own header) -->
            <Grid Grid.Row="0" Padding="24,14,24,10"
                  Visibility="{x:Bind ViewModel.WindowGridVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedFolder.Name, Mode=OneWay, FallbackValue='Select a folder'}"
                        FontSize="{StaticResource FontSizeLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedFolder.FilterInfo, Mode=OneWay, FallbackValue=''}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,2,0,0" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="&#xE72C; Refresh"
                    Command="{x:Bind ViewModel.RefreshWindowsCommand}"
                    Style="{StaticResource NeonButtonStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Window Cards Grid -->
            <GridView
                x:Name="WindowGrid"
                Grid.Row="1"
                Visibility="{x:Bind ViewModel.WindowGridVisibility, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Windows}"
                SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}"
                SelectionMode="Single"
                Padding="24,8,24,8"
                IsItemClickEnabled="False"
                IsTabStop="False"
                TabNavigation="Once"
                AllowFocusOnInteraction="False"
                XYFocusKeyboardNavigation="Disabled"
                SizeChanged="WindowGrid_SizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            ItemWidth="340"
                            ItemHeight="230"
                            HorizontalAlignment="Left" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WindowItemViewModel">
                        <Border Style="{StaticResource WindowCardStyle}" Margin="6"
                                CanDrag="True" DragStarting="WindowCard_DragStarting"
                                Tapped="WindowCard_Tapped"
                                RightTapped="WindowCard_RightTapped">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Switch To" Click="ContextMenu_SwitchTo">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pin / Unpin" Click="ContextMenu_TogglePin">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE718;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Minimize" Click="ContextMenu_Minimize">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE921;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Close Window" Click="ContextMenu_Close">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE711;" Foreground="#FF4444" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail Host â€” DWM thumbnails render here -->
                                <Border
                                    Tag="ThumbnailHost"
                                    Grid.Row="0"
                                    Background="#0D0D0D"
                                    CornerRadius="4"
                                    Margin="0,0,0,8">
                                    <!-- Fallback icon shown when DWM thumbnail not available -->
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Opacity="0.3">
                                        <FontIcon
                                            Glyph="&#xE737;"
                                            FontSize="28"
                                            Foreground="{StaticResource NeonGreenDimBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Desktop badge â€” visible in title strip when window is on another desktop) -->
                                <Border
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,0"
                                    Padding="5,1"
                                    CornerRadius="3"
                                    Background="#CC3A3A50"
                                    BorderBrush="{StaticResource NeonGreenDimBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind ShowDesktopBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon
                                            Glyph="&#xEDA4;"
                                            FontSize="9"
                                            Foreground="{StaticResource NeonGreenBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind DesktopBadge}"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NeonGreenBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Title Bar -->
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Ellipse
                                        Grid.Column="0"
                                        Grid.RowSpan="2"
                                        Width="8" Height="8"
                                        Fill="{StaticResource NeonGreenBrush}"
                                        VerticalAlignment="Center" />

                                    <!-- Pin indicator â€” now more visible -->
                                    <Border
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,0,0,0"
                                        Padding="4,2,4,2"
                                        CornerRadius="3"
                                        Background="#33FFD700"
                                        BorderBrush="#FFD700"
                                        BorderThickness="1"
                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon
                                            Glyph="&#xE718;"
                                            FontSize="12"
                                            Foreground="#FFD700"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Important window title (2nd segment of " - ") â€” bold, prominent -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Text="{x:Bind DisplayTitle}"
                                        FontSize="{StaticResource FontSizeMedium}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!-- Context: prefix + process name â€” small, muted -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind TitlePrefix}"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind TitlePrefix, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="Â·"
                                            FontSize="11"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Visibility="{x:Bind TitlePrefix, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind ProcessName}"
                                            FontSize="11"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="AllowFocusOnInteraction" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <!-- Root: clips children to rounded rect, no extra chrome -->
                                    <Grid x:Name="Root" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                        </Grid.RenderTransform>
                                        <VisualStateManager.VisualStateGroups>

                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="Transparent" />
                                                        <Setter Target="NeonBorder.Background" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="{StaticResource WindowHoverBorderBrush}" />
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>

                                            <VisualStateGroup x:Name="SelectionStates">
                                                <VisualState x:Name="Unselected">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="Transparent" />
                                                        <Setter Target="NeonBorder.Background" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                    <Storyboard>
                                                        <!-- Subtle scale-in pop for visual focus tracking -->
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="RootScale"
                                                            Storyboard.TargetProperty="ScaleX"
                                                            From="0.96" To="1.0" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="RootScale"
                                                            Storyboard.TargetProperty="ScaleY"
                                                            From="0.96" To="1.0" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="SelectedUnfocused">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="NeonBorder.BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                                                        <Setter Target="NeonBorder.Background" Value="{StaticResource WindowHoverBackgroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>

                                        </VisualStateManager.VisualStateGroups>

                                        <!-- Window card content -->
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                        <!-- Neon overlay border â€” painted on top, not interactive -->
                                        <Border
                                            x:Name="NeonBorder"
                                            CornerRadius="10"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <!-- CLIPBOARD HISTORY PANEL                                        -->
            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <Grid
                x:Name="ClipboardPanel"
                Grid.Row="1"
                Visibility="{x:Bind ViewModel.ClipboardPanelVisibility, Mode=OneWay}"
                Padding="24,8,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Clipboard History" FontSize="{StaticResource FontSizeLarge}"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                            <Run Text="{x:Bind ViewModel.ClipboardHistory.Count, Mode=OneWay}" /> items captured
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear All"
                            Command="{x:Bind ViewModel.ClearClipboardHistoryCommand}"
                            Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center" />
                </Grid>

                <!-- Items -->
                <ListView x:Name="ClipboardList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.ClipboardHistory}"
                          SelectedItem="{x:Bind ViewModel.SelectedClipboardItem, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Border Background="#15FFFFFF" CornerRadius="8" Padding="0" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Clickable area: tap anywhere to copy -->
                                    <Button Grid.Column="0"
                                            Click="ClipboardItem_Copy" Tag="{x:Bind}"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type icon -->
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind TypeIcon}" FontSize="16"
                                                      Foreground="{StaticResource NeonGreenDimBrush}" VerticalAlignment="Top"
                                                      Margin="0,2,0,0" />

                                            <!-- Image preview (image items only, loads async) -->
                                            <Image Grid.Column="1"
                                                   Source="{x:Bind ImageSource, Mode=OneWay}"
                                                   MaxHeight="120" MaxWidth="320"
                                                   Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Text content (text items only) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind SingleLinePreview}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind TimeAgo}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind SizeInfo}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Grid.Column="1" ToolTipService.ToolTip="Remove"
                                            Click="ClipboardItem_Remove" Tag="{x:Bind}"
                                            Background="Transparent" Padding="8,10" VerticalAlignment="Stretch">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#FF4444" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- â”€â”€ Success toast: "Elemento copiado con Ã©xito" â”€â”€â”€â”€â”€â”€â”€ -->
                <Border Grid.Row="1"
                        Visibility="{x:Bind ViewModel.ClipboardToastVisibility, Mode=OneWay}"
                        Background="#CC12201A"
                        BorderBrush="#3939FF14"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,9"
                        Margin="20,0,20,16"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#39FF14" />
                        <TextBlock Text="Elemento copiado con Ã©xito" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty State (also hosts the app launcher when search yields no windows) -->
            <Grid
                x:Name="EmptyStatePanel"
                Grid.Row="1"
                Visibility="{x:Bind ViewModel.HasNoWindows, Mode=OneWay}">

                <!-- â”€â”€ Default: not searching â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.ShowEmptyDefault, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE7B8;"
                        FontSize="52"
                        Foreground="{StaticResource NeonGreenDimBrush}" />
                    <TextBlock
                        Text="No windows found"
                        FontSize="{StaticResource FontSizeLarge}"
                        Foreground="{StaticResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0" />
                    <TextBlock
                        Text="Open some apps or change the folder filter"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>

                <!-- â”€â”€ App launcher suggestions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                <Grid
                    Visibility="{x:Bind ViewModel.ShowLaunchSuggestions, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Padding="32,20,32,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="13"
                            Foreground="{StaticResource NeonGreenDimBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="Launch"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="â†‘â†“ Navigate  Â·  Enter Launch  Â·  Double-click Launch"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource TextMutedBrush}"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Results list -->
                    <ListView
                        x:Name="LaunchList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.LaunchResults}"
                        SelectedItem="{x:Bind ViewModel.SelectedLaunchItem, Mode=TwoWay}"
                        SelectionMode="Single"
                        Background="Transparent"
                        BorderThickness="0"
                        IsItemClickEnabled="True"
                        ItemClick="LaunchList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaunchItemViewModel">
                                <Grid ColumnSpacing="12" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon: real app icon once loaded, fallback glyph while loading -->
                                    <Grid Grid.Column="0"
                                          Width="32" Height="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="&#xE8A5;"
                                            FontSize="20"
                                            Foreground="{StaticResource NeonGreenDimBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IconLoaded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Image
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Width="32" Height="32"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IconLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="{StaticResource FontSizeBase}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind FriendlyPath}"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="{StaticResource FontSizeXSmall}"
                                            TextTrimming="CharacterEllipsis"
                                            Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- â”€â”€ Run fallback: no results â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.ShowRunFallback, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        Glyph="&#xE756;"
                        FontSize="44"
                        Foreground="{StaticResource NeonGreenDimBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="No matches found"
                        FontSize="{StaticResource FontSizeLarge}"
                        Foreground="{StaticResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RunFallbackLabel, Mode=OneWay}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource NeonGreenDimBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>

            </Grid>

            <!-- Bottom Status Bar -->
            <Grid Grid.Row="2" Padding="24,8,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource TextMutedBrush}"
                    VerticalAlignment="Center">
                    <Run Text="Type to search" />
                    <Run Text="  |  " />
                    <Run Text="Left click to open a window or folder" />
                    <Run Text="  |  " />
                    <Run Text="Right click for window or folder options" />
                    <Run Text="  |  " />
                    <Run Text="Esc Close" />
                </TextBlock>

                <TextBlock
                    Grid.Column="1"
                    Text="BetterWinTab v1.0.0"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource NeonGreenDimBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- ADD FOLDER DIALOG (Overlay Panel)                              -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid
            x:Name="AddFolderPanel"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Visibility="{x:Bind ViewModel.IsAddFolderPanelVisible, Mode=OneWay}"
            Background="#CC000000">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource NeonGreenDimBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="32"
                Width="580"
                MaxHeight="840">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Create New Folder"
                        FontSize="{StaticResource FontSizeLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonGreenBrush}" />

                    <TextBox
                        Header="Folder Name"
                        PlaceholderText="e.g., Work, Gaming, Music..."
                        Text="{x:Bind ViewModel.NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NeonTextBoxStyle}" />

                    <!-- Icon Picker -->
                    <TextBlock
                        Text="Icon"
                        FontSize="{StaticResource FontSizeMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                    <GridView
                        x:Name="IconPicker"
                        ItemsSource="{x:Bind ViewModel.AvailableIcons}"
                        SelectedItem="{x:Bind ViewModel.SelectedIcon, Mode=TwoWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="False"
                        MaxHeight="110"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Width="32" Height="32" CornerRadius="6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind}" FontSize="18"
                                              Foreground="{StaticResource NeonGreenBrush}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="2" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <!-- Color Picker -->
                    <TextBlock
                        Text="Background Color"
                        FontSize="{StaticResource FontSizeMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                    <GridView
                        x:Name="ColorPicker"
                        ItemsSource="{x:Bind ViewModel.AvailableColors}"
                        SelectedItem="{x:Bind ViewModel.SelectedBgColor, Mode=TwoWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="False"
                        MaxHeight="60"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Ellipse Width="28" Height="28"
                                         Fill="{Binding Converter={StaticResource HexToBrush}}"
                                         Stroke="{StaticResource NeonGreenDimBrush}"
                                         StrokeThickness="1" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="2" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <ToggleSwitch
                        Header="Smart Folder (auto-filter by process)"
                        IsOn="{x:Bind ViewModel.IsSmartFolder, Mode=TwoWay}"
                        OnContent="Smart"
                        OffContent="Manual" />

                    <ComboBox
                        x:Name="AddFolderProcessFilter"
                        Header="Filter by Process"
                        PlaceholderText="Select a process..."
                        ItemsSource="{x:Bind ViewModel.AvailableProcesses}"
                        SelectedItem="{x:Bind ViewModel.SelectedProcessFilter, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsSmartFolder, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                    <!-- â”€â”€ Advanced: Composite Rules â”€â”€ -->
                    <ToggleSwitch
                        Header="Advanced Rules (AND/OR conditions)"
                        IsOn="{x:Bind ViewModel.IsSmartRulesFolder, Mode=TwoWay}"
                        OnContent="Rules"
                        OffContent="Off" />

                    <StackPanel
                        Visibility="{x:Bind ViewModel.IsSmartRulesFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Spacing="8">
                        <ComboBox
                            Header="Match"
                            ItemsSource="{x:Bind ViewModel.RuleOperatorOptions}"
                            SelectedItem="{x:Bind ViewModel.RuleOperator, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <!-- Existing conditions -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EditingRuleConditions}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderRuleCondition">
                                    <Border Background="#15FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,2">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                                <Run Text="{x:Bind FieldDisplay}" /> <Run Text="{x:Bind ComparisonDisplay}" Foreground="{StaticResource NeonGreenBrush}" /> <Run Text="{x:Bind Value}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="&#xE711;" FontSize="10" Padding="4,2"
                                                    Click="RemoveRuleCondition_Click" Tag="{x:Bind}"
                                                    Background="Transparent" Foreground="#FF4444" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Add new condition row -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.RuleFieldOptions}"
                                      SelectedItem="{x:Bind ViewModel.NewRuleField, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.RuleComparisonOptions}"
                                      SelectedItem="{x:Bind ViewModel.NewRuleComparison, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                            <TextBox Grid.Column="2" PlaceholderText="Value..."
                                     Text="{x:Bind ViewModel.NewRuleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" />
                            <Button Grid.Column="3" Content="+" Command="{x:Bind ViewModel.AddRuleConditionCommand}"
                                    Style="{StaticResource NeonButtonStyle}" Padding="8,4" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelAddFolderCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                        <Button
                            Content="Create"
                            Command="{x:Bind ViewModel.CreateFolderCommand}"
                            Style="{StaticResource NeonButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- EDIT FOLDER DIALOG (Overlay Panel)                             -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid
            x:Name="EditFolderPanel"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Visibility="{x:Bind ViewModel.IsEditFolderPanelVisible, Mode=OneWay}"
            Background="#CC000000">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource NeonGreenDimBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="32"
                Width="580"
                MaxHeight="840">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Edit Folder"
                        FontSize="{StaticResource FontSizeLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonGreenBrush}" />

                    <TextBox
                        Header="Folder Name"
                        PlaceholderText="e.g., Work, Gaming, Music..."
                        Text="{x:Bind ViewModel.EditFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NeonTextBoxStyle}" />

                    <!-- Icon Picker -->
                    <TextBlock
                        Text="Icon"
                        FontSize="{StaticResource FontSizeMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                    <GridView
                        ItemsSource="{x:Bind ViewModel.AvailableIcons}"
                        SelectedItem="{x:Bind ViewModel.EditFolderIcon, Mode=TwoWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="False"
                        MaxHeight="110"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Width="32" Height="32" CornerRadius="6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind}" FontSize="18"
                                              Foreground="{StaticResource NeonGreenBrush}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="2" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <!-- Color Picker -->
                    <TextBlock
                        Text="Background Color"
                        FontSize="{StaticResource FontSizeMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                    <GridView
                        ItemsSource="{x:Bind ViewModel.AvailableColors}"
                        SelectedItem="{x:Bind ViewModel.EditFolderBgColor, Mode=TwoWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="False"
                        MaxHeight="60"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Ellipse Width="28" Height="28"
                                         Fill="{Binding Converter={StaticResource HexToBrush}}"
                                         Stroke="{StaticResource NeonGreenDimBrush}"
                                         StrokeThickness="1" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="2" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <ToggleSwitch
                        Header="Smart Folder (auto-filter by process)"
                        IsOn="{x:Bind ViewModel.EditFolderIsSmart, Mode=TwoWay}"
                        OnContent="Smart"
                        OffContent="Manual" />

                    <ComboBox
                        x:Name="EditFolderProcessFilterCombo"
                        Header="Filter by Process"
                        PlaceholderText="Select a process..."
                        ItemsSource="{x:Bind ViewModel.AvailableProcesses}"
                        SelectedItem="{x:Bind ViewModel.EditFolderProcessFilter, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.EditFolderIsSmart, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                    <!-- â”€â”€ Advanced: Composite Rules â”€â”€ -->
                    <ToggleSwitch
                        Header="Advanced Rules (AND/OR conditions)"
                        IsOn="{x:Bind ViewModel.IsSmartRulesFolder, Mode=TwoWay}"
                        OnContent="Rules"
                        OffContent="Off" />

                    <StackPanel
                        Visibility="{x:Bind ViewModel.IsSmartRulesFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Spacing="8">
                        <ComboBox
                            Header="Match"
                            ItemsSource="{x:Bind ViewModel.RuleOperatorOptions}"
                            SelectedItem="{x:Bind ViewModel.RuleOperator, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <!-- Existing conditions -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EditingRuleConditions}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderRuleCondition">
                                    <Border Background="#15FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,2">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                                <Run Text="{x:Bind FieldDisplay}" /> <Run Text="{x:Bind ComparisonDisplay}" Foreground="{StaticResource NeonGreenBrush}" /> <Run Text="{x:Bind Value}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="&#xE711;" FontSize="10" Padding="4,2"
                                                    Click="RemoveRuleCondition_Click" Tag="{x:Bind}"
                                                    Background="Transparent" Foreground="#FF4444" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Add new condition row -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.RuleFieldOptions}"
                                      SelectedItem="{x:Bind ViewModel.NewRuleField, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.RuleComparisonOptions}"
                                      SelectedItem="{x:Bind ViewModel.NewRuleComparison, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                            <TextBox Grid.Column="2" PlaceholderText="Value..."
                                     Text="{x:Bind ViewModel.NewRuleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" />
                            <Button Grid.Column="3" Content="+" Command="{x:Bind ViewModel.AddRuleConditionCommand}"
                                    Style="{StaticResource NeonButtonStyle}" Padding="8,4" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelEditFolderCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                        <Button
                            Content="Save"
                            Command="{x:Bind ViewModel.SaveEditFolderCommand}"
                            Style="{StaticResource NeonButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- SETTINGS DIALOG (Hierarchical Nav Overlay)                     -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Grid
            x:Name="SettingsPanel"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Visibility="{x:Bind ViewModel.IsSettingsPanelVisible, Mode=OneWay}"
            Background="#CC000000">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource NeonGreenDimBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Width="860"
                Height="600">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- â”€â”€ Header â”€â”€ -->
                    <Border Grid.Row="0" Padding="28,18,28,14" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                        <TextBlock
                            Text="Settings"
                            FontSize="{StaticResource FontSizeXLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource NeonGreenBrush}" />
                    </Border>

                    <!-- â”€â”€ Body: Nav + Content â”€â”€ -->
                    <Grid Grid.Row="1" MinHeight="380">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Navigation -->
                        <ListView
                            x:Name="SettingsNav"
                            Grid.Column="0"
                            Padding="10,12,10,12"
                            SelectionMode="Single"
                            SelectionChanged="SettingsNav_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0">
                            <ListViewItem Tag="General" IsSelected="True">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="General"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="Themes">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="Themes"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="Accent">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="Accent"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="Bg">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="Backgrounds"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="Text">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="Typography"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="Status">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Text="Status"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,9" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- Vertical divider -->
                        <Border Grid.Column="1" Background="#22FFFFFF" />

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- GENERAL PANEL                                      -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="GeneralPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabGeneralVisible, Mode=OneWay}">
                            <StackPanel Spacing="20">
                                <StackPanel>
                                    <TextBlock Text="General"
                                               FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Application behaviour settings."
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <!-- Run at startup -->
                                <Border Background="{StaticResource CardSurfaceBrush}" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Start with Windows"
                                                       FontSize="{StaticResource FontSizeBase}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Launch BetterWinTab automatically when you log in."
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.SettingsRunAtStartup, Mode=TwoWay}"
                                                      OffContent="" OnContent=""
                                                      VerticalAlignment="Center"
                                                      Margin="16,0,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Global Hotkey -->
                                <Border Background="{StaticResource CardSurfaceBrush}" CornerRadius="8" Padding="16,12">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Text="Global Hotkey"
                                                       FontSize="{StaticResource FontSizeBase}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Key combination to show/hide the overlay. Click Record then press your combo."
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- Current hotkey display -->
                                        <Border Background="#0A0A0A" CornerRadius="4" Padding="10,6"
                                                HorizontalAlignment="Left">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.HotkeyDisplayText, Mode=OneWay}"
                                                FontFamily="Consolas"
                                                FontSize="{StaticResource FontSizeBase}"
                                                Foreground="{StaticResource NeonGreenBrush}" />
                                        </Border>
                                        <!-- Record / Cancel buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Record New Hotkey"
                                                    Click="RecordHotkey_Click"
                                                    Style="{StaticResource NeonButtonStyle}"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    Padding="10,6"
                                                    Visibility="{x:Bind ViewModel.IsRecordingHotkey, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <Button Content="Cancel Recording"
                                                    Click="CancelRecordHotkey_Click"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    Padding="10,6"
                                                    Visibility="{x:Bind ViewModel.IsRecordingHotkey, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- THEMES PANEL                                       -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="ThemesPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabThemesVisible, Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Theme Presets"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Click a preset for an instant live preview. Press Save to keep it."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Reset All Defaults"
                                            Command="{x:Bind ViewModel.ResetAppearanceDefaultsCommand}"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                            CornerRadius="6" Padding="12,6"
                                            FontSize="{StaticResource FontSizeSmall}" />
                                </Grid>

                                <!-- Built-in preset cards grid -->
                                <ListView
                                    x:Name="PresetList"
                                    ItemsSource="{x:Bind ViewModel.AvailablePresets}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="PresetList_ItemClick">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"
                                                           ItemWidth="88" ItemHeight="96"
                                                           MaximumRowsOrColumns="6" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="76" Height="84" CornerRadius="8"
                                                    BorderBrush="#2A2A2A" BorderThickness="1"
                                                    Background="#0F0F0F" Padding="4">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                    <Ellipse Width="30" Height="30" HorizontalAlignment="Center"
                                                             Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="9" TextAlignment="Center"
                                                               Foreground="#CCCCCC" TextWrapping="Wrap" MaxWidth="68" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>

                                <!-- â”€â”€ Custom Palettes â”€â”€ -->
                                <Border Height="1" Background="#22FFFFFF" Margin="0,4,0,0" />

                                <TextBlock Text="Your Palettes"
                                           FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Save the current colors as a reusable palette."
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextMutedBrush}" />

                                <!-- Save input row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="Palette name"
                                        PlaceholderText="e.g. My Dark Theme"
                                        Text="{x:Bind ViewModel.NewPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Content="Save Palette"
                                            Command="{x:Bind ViewModel.SaveCustomPresetCommand}"
                                            Style="{StaticResource NeonButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Margin="8,0,0,0"
                                            Padding="14,8" />
                                </Grid>

                                <!-- Custom presets list -->
                                <ListView
                                    x:Name="CustomPresetList"
                                    ItemsSource="{x:Bind ViewModel.CustomPresets}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="CustomPresetList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" MinHeight="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Accent swatch -->
                                                <Ellipse Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                                <!-- Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <!-- Delete button â€” Tag binds to the item via code-behind click -->
                                                <Button Grid.Column="2"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Tag="{Binding}"
                                                        Click="DeleteCustomPreset_Click"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        BorderThickness="0"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="2,0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- ACCENT PANEL                                       -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="AccentPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabAccentVisible, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <!-- Section header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Accent Colors"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Primary highlight and its tonal variants."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Reset Section"
                                                Command="{x:Bind ViewModel.ResetAccentSectionCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                        <Button Content="Reset All"
                                                Command="{x:Bind ViewModel.ResetAppearanceDefaultsCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Accent Color -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="Accent Color"
                                             Text="{x:Bind ViewModel.SettingsAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom"
                                            Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent"
                                            BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3"
                                                Background="{x:Bind ViewModel.SettingsAccentColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Opened="ColorFlyout_Opened">
                                                <ColorPicker x:Name="CP_Accent" Tag="Accent" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Accent Dim -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="Accent Dim"
                                             Text="{x:Bind ViewModel.SettingsAccentDimColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom"
                                            Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent"
                                            BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3"
                                                Background="{x:Bind ViewModel.SettingsAccentDimColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Opened="ColorFlyout_Opened">
                                                <ColorPicker x:Name="CP_AccentDim" Tag="AccentDim" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Accent Subtle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="Accent Subtle"
                                             Text="{x:Bind ViewModel.SettingsAccentSubtleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom"
                                            Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent"
                                            BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3"
                                                Background="{x:Bind ViewModel.SettingsAccentSubtleColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Opened="ColorFlyout_Opened">
                                                <ColorPicker x:Name="CP_AccentSubtle" Tag="AccentSubtle" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- BACKGROUNDS PANEL                                  -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="BackgroundsPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabBgVisible, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Backgrounds"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Background, surface, card and border colors."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Reset Section"
                                                Command="{x:Bind ViewModel.ResetBgSectionCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                        <Button Content="Reset All"
                                                Command="{x:Bind ViewModel.ResetAppearanceDefaultsCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Background -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Background" Text="{x:Bind ViewModel.SettingsBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsBackgroundColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Background" Tag="Background" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Surface -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Surface (sidebar)" Text="{x:Bind ViewModel.SettingsSurfaceColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsSurfaceColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Surface" Tag="Surface" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Card -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Card (window cards)" Text="{x:Bind ViewModel.SettingsCardColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsCardColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Card" Tag="Card" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Border -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Border" Text="{x:Bind ViewModel.SettingsBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsBorderColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Border" Tag="Border" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Folder Hover -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Folder Hover overlay" Text="{x:Bind ViewModel.SettingsFolderHoverColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsFolderHoverColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_FolderHover" Tag="FolderHover" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Folder Selected -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Folder Selected overlay" Text="{x:Bind ViewModel.SettingsFolderSelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsFolderSelectedColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_FolderSelected" Tag="FolderSelected" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Window Hover Border -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Window Hover Border" Text="{x:Bind ViewModel.SettingsWindowHoverBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsWindowHoverBorderColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_WindowHoverBorder" Tag="WindowHoverBorder" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Window Hover Background -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Window Hover Background" Text="{x:Bind ViewModel.SettingsWindowHoverBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsWindowHoverBackgroundColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_WindowHoverBackground" Tag="WindowHoverBackground" IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- TYPOGRAPHY PANEL                                   -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="TypographyPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabTextVisible, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Typography"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Text hierarchy colors."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Reset Section"
                                                Command="{x:Bind ViewModel.ResetTextSectionCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                        <Button Content="Reset All"
                                                Command="{x:Bind ViewModel.ResetAppearanceDefaultsCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Text Primary -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Text Primary" Text="{x:Bind ViewModel.SettingsTextPrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsTextPrimaryColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_TextPrimary" Tag="TextPrimary" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Text Secondary -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Text Secondary" Text="{x:Bind ViewModel.SettingsTextSecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsTextSecondaryColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_TextSecondary" Tag="TextSecondary" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Text Muted -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Text Muted" Text="{x:Bind ViewModel.SettingsTextMutedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsTextMutedColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_TextMuted" Tag="TextMuted" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <!-- STATUS PANEL                                       -->
                        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
                        <ScrollViewer x:Name="StatusPanel" Grid.Column="2" Padding="24,18" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.TabStatusVisible, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Status"
                                                   FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Danger and other status indicator colors."
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Reset Section"
                                                Command="{x:Bind ViewModel.ResetStatusSectionCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                        <Button Content="Reset All"
                                                Command="{x:Bind ViewModel.ResetAppearanceDefaultsCommand}"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1" BorderBrush="{StaticResource TextMutedBrush}"
                                                CornerRadius="6" Padding="10,5"
                                                FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Danger -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Danger (delete buttons)" Text="{x:Bind ViewModel.SettingsDangerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                                    <Button Grid.Column="1" Width="36" Height="36" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="0" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource NeonGreenDimBrush}" BorderThickness="1">
                                        <Border Width="22" Height="22" CornerRadius="3" Background="{x:Bind ViewModel.SettingsDangerColor, Converter={StaticResource HexToBrush}, Mode=OneWay}" />
                                        <Button.Flyout><Flyout Opened="ColorFlyout_Opened"><ColorPicker x:Name="CP_Danger" Tag="Danger" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>

                    <!-- â”€â”€ Footer (fixed) â”€â”€ -->
                    <Border Grid.Row="2" Padding="24,12" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Social Links (left) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Button ToolTipService.ToolTip="LinkedIn" Click="LinkedIn_Click"
                                        Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                                    <Viewbox Width="20" Height="20">
                                        <Path Fill="White" Stretch="Uniform" Data="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zM20 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765C14.396 7.179 20 6.988 20 12.241V19z" />
                                    </Viewbox>
                                </Button>
                                <Button ToolTipService.ToolTip="GitHub" Click="GitHub_Click"
                                        Background="Transparent" BorderThickness="0" Padding="4" Width="36" Height="36">
                                    <Viewbox Width="20" Height="20">
                                        <Path Fill="White" Stretch="Uniform" Data="M12 0c-6.627 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.106-.774.418-1.305.761-1.604-2.666-.304-5.467-1.333-5.467-5.93 0-1.312.469-2.382 1.236-3.222-.124-.303-.535-1.524.117-3.176 0 0 1.009-.322 3.301 1.23A11.513 11.513 0 0112 5.802c1.02.004 2.047.138 3.006.404 2.291-1.552 3.3-1.23 3.3-1.23.653 1.653.242 2.874.118 3.176.768.84 1.236 1.91 1.236 3.222 0 4.609-2.804 5.625-5.475 5.921.43.371.813 1.102.813 2.222v3.293c0 .319.192.694.801.576C20.565 21.796 24 17.299 24 12c0-6.627-5.373-12-12-12z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                            <!-- Action Buttons (right) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button
                                    Content="Cancel"
                                    Command="{x:Bind ViewModel.CancelSettingsCommand}"
                                    Style="{StaticResource DangerButtonStyle}" />
                                <Button
                                    Content="Save"
                                    Command="{x:Bind ViewModel.SaveSettings_UICommand}"
                                    Style="{StaticResource NeonButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>


