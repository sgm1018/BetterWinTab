<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterWinTab.Views.SshWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterWinTab.ViewModels"
    Loaded="Workspace_Loaded"
    Unloaded="Workspace_Unloaded">

    <UserControl.Resources>
        <Style x:Key="MachineListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24" Background="{ThemeResource PureBlackBrush}">
        <Grid x:Name="BrowsePanel" RowSpacing="14" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SSH" FontSize="26" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="AddButton" Grid.Column="1" Click="AddButton_Click"
                        Background="{ThemeResource FolderSelectedBrush}"
                        BorderBrush="{ThemeResource NeonGreenDimBrush}"
                        Foreground="{ThemeResource NeonGreenBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Add machine" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown" PlaceholderText="Search by IP address, name, or user"
                     AutomationProperties.Name="Search SSH machines" />

            <InfoBar x:Name="WorkspaceStatus" Grid.Row="2" Severity="Error" IsOpen="False" />

            <Grid Grid.Row="3">
                <ListView x:Name="MachineList"
                          ItemsSource="{x:Bind ViewModel.Results}"
                          ItemContainerStyle="{StaticResource MachineListItemStyle}"
                          SelectionMode="None" AutomationProperties.Name="Saved SSH machines">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SshMachineListItem">
                            <Border CornerRadius="8" Background="{ThemeResource DarkSurfaceBrush}"
                                    BorderBrush="{ThemeResource NeonGreenSubtleBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Tag="{x:Bind Machine}" Click="ConnectButton_Click"
                                            AutomationProperties.Name="{x:Bind ConnectLabel}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="12,10" Background="Transparent" BorderThickness="0">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE756;" FontSize="18"
                                                      Foreground="{ThemeResource NeonGreenBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Endpoint}" FontSize="12"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="Connect"
                                                       VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{ThemeResource NeonGreenBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{x:Bind OptionsLabel}">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit machine" Tag="{x:Bind Machine}" Click="EditMachine_Click" />
                                                <MenuFlyoutItem Text="Remove machine" Tag="{x:Bind Machine}" Click="RemoveMachine_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" Spacing="8" Margin="12" MaxWidth="370"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE756;" FontSize="32"
                              Foreground="{ThemeResource NeonGreenDimBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="No SSH machines"
                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyDescription" Text="Add a machine to connect from BetterWinTab."
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="580" HorizontalAlignment="Stretch" Spacing="14" Padding="0,0,12,12">
                <TextBlock x:Name="EditorTitle" Text="Add SSH machine"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBox x:Name="NameBox" Header="Name (optional)" PlaceholderText="Production database" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" Header="IP address" PlaceholderText="192.0.2.10" />
                    <TextBox x:Name="PortBox" Grid.Column="1" Header="Port" Text="22"
                             InputScope="Number" MaxLength="5" />
                </Grid>
                <TextBox x:Name="UsernameBox" Header="Username" />
                <PasswordBox x:Name="MachinePasswordBox" Header="Password" PasswordRevealMode="Hidden" />
                <InfoBar x:Name="EditorStatus" Severity="Error" IsOpen="False" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Save machine" Click="SaveMachine_Click"
                            Background="{ThemeResource FolderSelectedBrush}"
                            BorderBrush="{ThemeResource NeonGreenDimBrush}"
                            Foreground="{ThemeResource NeonGreenBrush}" />
                    <Button Content="Cancel" Click="CancelMachine_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
